{
  "rewrites": [
    {
      "source": "/api/media",
      "destination": "/api/media/upload"
    },
    {
      "source": "/api/fll",
      "destination": "/api/fll/season"
    },
    {
      "source": "/api/fll/audio/config",
      "destination": "/api/fll/config"
    },
    {
      "source": "/api/fll/audio/:slot",
      "destination": "/api/fll/audio?slot=:slot"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npx --yes --package=npm@11.21.0 npm ci --include=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
